# General
PROJECT_NAME="ODRISYSTEMS Dockerized Service Monitor"
ENV=development

# Database Configuration
POSTGRES_USER=odri_admin
POSTGRES_PASSWORD=odri_secure_password_123
POSTGRES_DB=odri_monitor_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://odri_admin:odri_secure_password_123@postgres:5432/odri_monitor_db

# Security & Auth
SECRET_KEY=super_secret_jwt_key_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Docker Engine Connection
DOCKER_HOST=unix://var/run/docker.sock

# Frontend API Endpoints (Proxied via Nginx)
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
